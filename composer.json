{
    "name": "dyangalih/laravel-region",
    "description": "Indonesian regional data (Provinces, Regencies, Districts, Villages) for Laravel.",
    "keywords": [
        "dyangalih",
        "laravel",
        "laravel-region",
        "indonesia",
        "provinces",
        "regencies"
    ],
    "homepage": "https://github.com/DyanGalih/laravel-region",
    "license": "MIT",
    "authors": [
        {
            "name": "Dyan Galih",
            "email": "galih@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-data": "^3.0|^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1|^7.10|^9.0",
        "orchestra/testbench": "^8.22|^9.0|^10.0",
        "pestphp/pest": "^2.34|^3.0",
        "pestphp/pest-plugin-laravel": "^2.3|^3.0"
    },
    "autoload": {
        "psr-4": {
            "DyanGalih\\LaravelRegion\\": "src/",
            "DyanGalih\\LaravelRegion\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DyanGalih\\LaravelRegion\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DyanGalih\\LaravelRegion\\RegionServiceProvider"
            ],
            "aliases": {
                "Region": "DyanGalih\\LaravelRegion\\Facades\\Region"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    }
}
